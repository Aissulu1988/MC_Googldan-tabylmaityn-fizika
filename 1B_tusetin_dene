function steps(h){return h<=50?5:h<=120?10:h<=400?50:h<=1000?100:250}
function buildDyn(){while(dyn.children.length){const o=dyn.children[0];dyn.remove(o);o.traverse(n=>{if(n.geometry)n.geometry.dispose()})}
