#hud b{font-variant-numeric:tabular-nums}
#hud .k{color:#9fb4dd;font-weight:500}
#banner{position:absolute;left:50%;top:14px;transform:translateX(-50%);padding:12px 20px;border-radius:16px;font:800 17px/1.3 system-ui;color:#fff;text-align:center;background:rgba(10,16,30,.8);box-shadow:0 12px 30px rgba(0,0,0,.45);display:none;max-width:90%}
#note{font-size:12.5px;color:var(--mut);margin-top:8px}
canvas.gr{width:100%;height:auto;border-radius:12px;background:#0d1628;box-shadow:inset 0 2px 8px rgba(0,0,0,.5)}
@media (prefers-reduced-motion:reduce){.btn{transition:none}}
</style>
</head>
<body>
<div id="app">
<div id="stage"><div id="hud"></div><div id="banner"></div></div>
<aside id="panel"><div class="ttl"><div class="code">1Б</div><div><h1>Түсетін дене</h1><p class="sub">Еркін түсу: планетаны, ауа кедергісін және биіктікті өзгертіңіз</p></div></div></aside>
</div>
