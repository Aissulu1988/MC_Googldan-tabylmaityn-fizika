for(let m=st;m<=h;m+=st){const pts=[];for(let k=0;k<=48;k++){const a=k/48*6.283;pts.push(new THREE.Vector3(Math.cos(a)*3,m,Math.sin(a)*3))}dyn.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts),lm));const lb=label(m+' м',{fs:44,s:.8});lb.position.set(-4,m,0);dyn.add(lb)}
if(h<=150){const w=new THREE.Mesh(new THREE.BoxGeometry(8,h,8),new THREE.MeshStandardMaterial({map:tex(128,128,(x,w2,h2)=>{x.fillStyle='#7d8a99';x.fillRect(0,0,w2,h2);for(let a=0;a<4;a++)for(let b=0;b<4;b++){x.fillStyle=Math.random()<.35?'#ffe9a8':'#2a3a50';x.fillRect(a*32+6,b*32+6,20,22)}},[2,Math.max(1,h/6)]),roughness:.7}));w.position.set(9,h/2,0);w.castShadow=true;dyn.add(w);const ar=new THREE.Mesh(new THREE.BoxGeometry(5,.3,.4),mt(0xffb21f,.4));ar.position.set(2.5,h+.6,0);dyn.add(ar)}
else{const cm=new THREE.MeshStandardMaterial({color:S.pl=='Юпитер'?0xffc08a:0xffffff,roughness:1,transparent:true,opacity:.92});for(let i=0;i<26;i++){const c=new THREE.Mesh(new THREE.SphereGeometry(rnd(6,14),12,10),cm);c.position.set(rnd(-45,45),h+rnd(6,12),rnd(-30,20));c.scale.y=.55;dyn.add(c)}}}
// object
const obj=new THREE.Group(),dropM=new THREE.Mesh(new THREE.SphereGeometry(RO,24,18),new THREE.MeshStandardMaterial({color:0x7cc8ff,roughness:.05,transparent:true,opacity:.82,emissive:0x1a60b0,emissiveIntensity:.45})),ballM=new THREE.Mesh(new THREE.SphereGeometry(RO,32,24),new THREE.MeshStandardMaterial({color:0xc8d0dc,roughness:.28,metalness:.7}));
dropM.scale.y=1.3;dropM.castShadow=ballM.castShadow=true;obj.add(dropM,ballM);const og=glow('rgba(140,210,255,.9)',3.2);obj.add(og);scene.add(obj);
// streaks
const NS=420,sp=new Float32Array(NS*6),sx=[],sz=[],sy=[];for(let i=0;i<NS;i++){sx.push(rnd(-14,14));sz.push(rnd(-10,8));sy.push(rnd(-20,20))}
const sg=new THREE.BufferGeometry();sg.setAttribute('position',new THREE.BufferAttribute(sp,3));const sm=new THREE.LineSegments(sg,new THREE.LineBasicMaterial({color:0xcfe8ff,transparent:true,opacity:.5}));sm.frustumCulled=false;scene.add(sm);
const rg=new THREE.Mesh(new THREE.RingGeometry(.5,.8,48),new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:0,side:THREE.DoubleSide,depthWrite:false}));rg.rotation.x=-Math.PI/2;rg.position.y=.03;scene.add(rg);
function env(){const p=PL[S.pl],vac=!aOn();dome.paint(vac&&S.pl!='Ай'?['#03040a','#0a0c26','#171046']:p.sky);stars.visible=vac;scene.fog=(!vac&&p.fog)?new THREE.Fog(p.fog,120,3200):null;hemi.intensity=p.hi;sun.intensity=p.si;sun.color.setHex(p.sc);gm.material.map=gT[S.pl];gm.material.needsUpdate=true;forest.visible=S.pl=='Жер';rocks.visible=S.pl!='Жер';earthSky.visible=S.pl=='Ай';sm.visible=!vac;sm.material.color.setHex(S.obj=='drop'&&S.pl=='Жер'?0x9fd2ff:0xffffff);dropM.visible=S.obj=='drop';ballM.visible=S.obj!='drop';og.visible=S.obj=='drop'}
function reset(){S.run=false;S.done=false;S.t=0;S.v=0;S.a=PL[S.pl].g;S.y=S.h;S.T=[];S.VA=[];S.ls=0;rg.material.opacity=0;buildDyn();env();setBtn()}
// UI
const g1=sec('Планета'),g2=sec('Дене'),g3=sec('Биіктік және орта'),g4=sec('Жылдамдық'),g5=sec('Басқару'),g6=sec('v(t) графигі');
seg(g1,[['Жер','🌍 Жер'],['Ай','🌙 Ай'],['Юпитер','🪐 Юпитер']],'Жер',k=>{S.pl=k;if(k=='Ай')S.air=false;airBtn.classList.toggle('on',S.air);airBtn.disabled=k=='Ай';reset()});
seg(g2,[['drop','💧 Жаңбыр тамшысы'],['ball','⚪ Болат шар']],'drop',k=>{S.obj=k;reset()});
const hs=slider(g3,'Биіктік h',1,2000,1,45,v=>v+' м',v=>{S.h=v;reset()});
[10,45,100,500,2000].forEach(v=>btn(g3,v+' м','c',()=>hs.set(v)));
const airBtn=btn(g3,'💨 Ауа кедергісі','c on',()=>{if(S.pl=='Ай')return;S.air=!S.air;airBtn.classList.toggle('on',S.air);reset()});
seg(g4,[[1,'×1'],[5,'×5'],[20,'×20']],1,k=>S.spd=k);
const goB=btn(g5,'▶ Жіберу','g',()=>{if(S.done)reset();S.run=true;setBtn()});btn(g5,'↺ Қайта','r',reset);
function setBtn(){goB.textContent=S.done?'▶ Қайта жіберу':'▶ Жіберу'}
const gc=el('<canvas class="gr" width="640" height="260"></canvas>');g6.appendChild(gc);const gx=gc.getContext('2d');
g6.appendChild(el('<div id="note">Көк сызық: нақты жылдамдық. Сарғыш үзік сызық: ауасыз (v = g·t). Екі сызықтың айырмасы ауа кедергісін көрсетеді.</div>'));
function graph(){const w=640,h=260,tv=Math.sqrt(2*S.h/PL[S.pl].g),tm=Math.max(S.t*1.05,tv,1),g=PL[S.pl].g,vm=Math.max(g*tm,1);gx.clearRect(0,0,w,h);gx.strokeStyle='rgba(255,255,255,.18)';gx.fillStyle='#9fb4dd';gx.font='20px system-ui';for(let i=0;i<=4;i++){const y=h-30-(h-50)*i/4;gx.beginPath();gx.moveTo(50,y);gx.lineTo(w-10,y);gx.stroke();gx.fillText(fm(vm*i/4,0),4,y+6)}gx.fillText('t, с → '+fm(tm,1),w-170,h-6);
gx.setLineDash([8,6]);gx.strokeStyle='#ffb21f';gx.lineWidth=3;gx.beginPath();for(let k=0;k<=60;k++){const t=Math.min(tv,tm)*k/60,x=50+(w-60)*t/tm,y=h-30-(h-50)*(g*t)/vm;k?gx.lineTo(x,y):gx.moveTo(x,y)}gx.stroke();gx.setLineDash([]);
gx.strokeStyle='#4aa8ff';gx.lineWidth=4;gx.beginPath();S.T.forEach((t,i)=>{const x=50+(w-60)*t/tm,y=h-30-(h-50)*S.VA[i]/vm;i?gx.lineTo(x,y):gx.moveTo(x,y)});gx.stroke()}
// physics
function stepPhys(dt){if(!S.run||S.done)return;const rem=dt*S.spd,n=Math.ceil(rem/.01),hh=rem/n,g=PL[S.pl].g,vt=(S.obj=='drop'?9:95)*Math.sqrt(g/9.8);for(let i=0;i<n;i++){S.a=g-(aOn()?g/(vt*vt)*S.v*Math.abs(S.v):0);S.v+=S.a*hh;S.y-=S.v*hh;S.t+=hh;if(S.y<=RO){S.y=RO;S.done=true;S.run=false;S.ring=1;setBtn();break}}
const tv=Math.sqrt(2*S.h/g);if(S.t-S.ls>=Math.max(.04,tv/160)||S.done){S.ls=S.t;S.T.push(S.t);S.VA.push(S.v)}}
let hudT=0;
function update(dt,time){stepPhys(dt);const g=PL[S.pl].g;obj.position.set(0,S.y,0);
const cy=Math.max(S.y+1.5,2.2);camera.position.set(6+Math.sin(time*.4)*.5,cy,13);camera.lookAt(0,Math.max(S.y,1),0);dome.position.copy(camera.position);stars.position.copy(camera.position);
sun.target.position.set(0,0,0);sun.target.updateMatrixWorld();
const vv=S.v,len=.25+Math.min(2.5,vv*.04);for(let i=0;i<NS;i++){sy[i]+=vv*dt*S.spd*.9;if(sy[i]>20)sy[i]-=40;const y=S.y+sy[i];sp.set([sx[i],y,sz[i],sx[i],y-len,sz[i]],i*6)}sg.attributes.position.needsUpdate=true;sm.material.opacity=S.run?.5:0;
if(S.ring>0){S.ring+=dt*1.6;const r=S.ring*5;rg.scale.setScalar(r);rg.material.opacity=Math.max(0,.8-S.ring*.4);if(S.ring>2)S.ring=0}
if(S.pl=='Юпитер'){if(S.flash<=0&&Math.random()<.004)S.flash=.25;if(S.flash>0){S.flash-=dt;hemi.intensity=1.4}else hemi.intensity=PL.Юпитер.hi}
hudT+=dt;if(hudT>.08){hudT=0;const tv=Math.sqrt(2*S.h/g);hud.innerHTML=`<div><span class="k">t =</span> <b>${fm(S.t,2)} с</b> &nbsp; <span class="k">h =</span> <b>${fm(Math.max(0,S.y-RO),1)} м</b></div><div><span class="k">v =</span> <b>${fm(S.v,1)} м/с</b> (${fm(S.v*3.6,0)} км/сағ) &nbsp; <span class="k">a =</span> <b>${fm(S.a,2)} м/с²</b></div><div><span class="k">Ауасыз болса:</span> t = <b>${fm(tv,2)} с</b>, v = <b>${fm(g*tv,1)} м/с</b></div>`;graph()}}
reset();start();

</script>
