const gT={
'Жер':tex(512,512,(x,w,h)=>{x.fillStyle='#3d8b37';x.fillRect(0,0,w,h);for(let i=0;i<5000;i++){x.fillStyle=`hsl(${rnd(85,125)},${rnd(40,60)}%,${rnd(22,42)}%)`;x.fillRect(rnd(0,w),rnd(0,h),2,rnd(4,10))}},[500,500]),
'Ай':tex(512,512,(x,w,h)=>{x.fillStyle='#8b8b90';x.fillRect(0,0,w,h);for(let i=0;i<4000;i++){x.fillStyle=`rgba(${rv(60,200)},${rv(60,200)},${rv(60,200)},.18)`;x.fillRect(rnd(0,w),rnd(0,h),rnd(1,4),rnd(1,4))}for(let i=0;i<14;i++){const cx=rnd(0,w),cy=rnd(0,h),r=rnd(16,60),g=x.createRadialGradient(cx,cy,r*.2,cx,cy,r);g.addColorStop(0,'rgba(40,40,45,.55)');g.addColorStop(.85,'rgba(60,60,66,.3)');g.addColorStop(1,'rgba(200,200,205,.5)');x.fillStyle=g;x.beginPath();x.arc(cx,cy,r,0,7);x.fill()}},[300,300]),
