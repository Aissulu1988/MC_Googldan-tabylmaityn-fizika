html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0}
body{background:var(--page);color:var(--ink);font-family:system-ui,"Segoe UI",Roboto,Arial,sans-serif;overflow:hidden}
#app{height:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(330px,410px)}
@media(max-width:860px){#app{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) minmax(0,48%)}}
#stage{position:relative;min-height:0;overflow:hidden;touch-action:none;background:#0b1220}
#stage canvas{display:block;width:100%;height:100%}
#panel{background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-left:1px solid var(--line);padding:14px 16px 24px;overflow:auto}
.ttl{display:flex;gap:12px;align-items:center;margin-bottom:6px}
.code{flex:none;width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-weight:800;font-size:20px;color:#fff;background:linear-gradient(180deg,#5ea0ff,#1f5fd8);box-shadow:0 5px 0 #14409a,0 8px 14px rgba(0,0,0,.3),inset 0 2px 0 rgba(255,255,255,.5)}
h1{font-size:19px;line-height:1.15;margin:0}
.sub{margin:2px 0 0;font-size:12.5px;color:var(--mut)}
section{margin-top:14px;padding-top:10px;border-top:1px solid var(--line)}
h3{margin:0 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut)}
.grp{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.ctl{flex:1 1 100%}.top{display:flex;justify-content:space-between;font-size:13.5px;margin-bottom:6px}
.rng{display:flex;align-items:center;gap:10px}
.btn{font:700 15px/1 system-ui,sans-serif;border:0;border-radius:14px;padding:12px 16px;color:#2b1700;cursor:pointer;background:linear-gradient(180deg,#ffe08a 0%,#ffb21f 55%,#f08a00 100%);box-shadow:0 6px 0 #b26200,0 10px 16px rgba(0,0,0,.32),inset 0 2px 0 rgba(255,255,255,.75),inset 0 -3px 6px rgba(160,70,0,.35);transition:transform .08s,box-shadow .08s,filter .15s;touch-action:manipulation;user-select:none}
.btn:hover{filter:brightness(1.07)}
.btn:active,.btn.on{transform:translateY(5px);box-shadow:0 1px 0 #b26200,0 3px 8px rgba(0,0,0,.32),inset 0 3px 8px rgba(120,50,0,.5)}
.btn.g{background:linear-gradient(180deg,#b4f5ab,#37c44c 55%,#1f9a35);color:#04210b;box-shadow:0 6px 0 #146e25,0 10px 16px rgba(0,0,0,.32),inset 0 2px 0 rgba(255,255,255,.7),inset 0 -3px 6px rgba(10,80,30,.35)}
.btn.g:active{box-shadow:0 1px 0 #146e25,0 3px 8px rgba(0,0,0,.32),inset 0 3px 8px rgba(5,60,20,.5)}
.btn.r{background:linear-gradient(180deg,#ffb0a8,#f0503f 55%,#c92a1a);color:#fff;box-shadow:0 6px 0 #8c180d,0 10px 16px rgba(0,0,0,.32),inset 0 2px 0 rgba(255,255,255,.6),inset 0 -3px 6px rgba(90,10,0,.35)}
.btn.r:active{box-shadow:0 1px 0 #8c180d,0 3px 8px rgba(0,0,0,.32),inset 0 3px 8px rgba(80,5,0,.5)}
.btn.c{background:linear-gradient(180deg,#f2f5fc,#c9d2e6 60%,#aab6d2);color:#1b2640;box-shadow:0 6px 0 #6f7da3,0 10px 16px rgba(0,0,0,.28),inset 0 2px 0 rgba(255,255,255,.9),inset 0 -3px 6px rgba(60,80,130,.3);padding:10px 14px;font-size:14px}
.btn.c.on{background:linear-gradient(180deg,#86b8ff,#2f7cf0 60%,#1d5fd0);color:#fff;box-shadow:0 1px 0 #123e90,0 3px 8px rgba(0,0,0,.3),inset 0 3px 8px rgba(10,40,120,.55),0 0 14px rgba(70,140,255,.7)}
.btn.sm{padding:6px 13px;font-size:20px;border-radius:12px;box-shadow:0 4px 0 #b26200,0 7px 12px rgba(0,0,0,.3),inset 0 2px 0 rgba(255,255,255,.75)}
.btn[disabled]{filter:grayscale(.9) opacity(.45);pointer-events:none}
input[type=range]{-webkit-appearance:none;appearance:none;flex:1;min-width:0;height:14px;border-radius:9px;background:linear-gradient(180deg,#b9c4de,#e9eef9);box-shadow:inset 0 3px 6px rgba(0,0,0,.35);outline:0}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:32px;height:32px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0,#ffd27a 30%,#ff9d1f 70%,#c46100 100%);box-shadow:0 5px 9px rgba(0,0,0,.5),inset 0 -3px 5px rgba(120,50,0,.4);border:0;cursor:grab}
input[type=range]::-moz-range-thumb{width:32px;height:32px;border:0;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0,#ffd27a 30%,#ff9d1f 70%,#c46100 100%);box-shadow:0 5px 9px rgba(0,0,0,.5)}
#hud{position:absolute;left:12px;top:12px;max-width:calc(100% - 24px);padding:10px 14px;border-radius:16px;background:rgba(8,14,28,.66);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#fff;font:600 14px/1.45 system-ui,sans-serif;box-shadow:0 10px 28px rgba(0,0,0,.4);pointer-events:none}
#hud b{font-variant-numeric:tabular-nums}
#hud .k{color:#9fb4dd;font-weight:500}
#banner{position:absolute;left:50%;top:14px;transform:translateX(-50%);padding:12px 20px;border-radius:16px;font:800 17px/1.3 system-ui;color:#fff;text-align:center;background:rgba(10,16,30,.8);box-shadow:0 12px 30px rgba(0,0,0,.45);display:none;max-width:90%}
#note{font-size:12.5px;color:var(--mut);margin-top:8px}
canvas.gr{width:100%;height:auto;border-radius:12px;background:#0d1628;box-shadow:inset 0 2px 8px rgba(0,0,0,.5)}
@media (prefers-reduced-motion:reduce){.btn{transition:none}}
</style>
</head>
<body>
<div id="app">
<div id="stage"><div id="hud"></div><div id="banner"></div></div>
<aside id="panel"><div class="ttl"><div class="code">2Б</div><div><h1>Жер қозғалысы</h1><p class="sub">Жердің өз осінен айналуы және Күнді айнала қозғалысы</p></div></div></aside>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>

const $=(s,r=document)=>r.querySelector(s),el=h=>{const d=document.createElement('div');d.innerHTML=h.trim();return d.firstChild};
const fm=(x,d=1)=>(+x).toFixed(d).replace('.',',');
const stage=$('#stage'),panel=$('#panel'),hud=$('#hud'),banner=$('#banner');
if(!window.THREE){stage.innerHTML='<p style="padding:24px;color:#fff">Three.js жүктелмеді. Интернетті тексеріп, бетті жаңартыңыз.</p>';throw new Error('three')}
const renderer=new THREE.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio||1,2));
renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputEncoding=THREE.sRGBEncoding;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.05;
stage.prepend(renderer.domElement);
const scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(50,1,.1,6000);
